# Modelo do .env usado pelo docker-compose.
#
# O `./iniciar.sh` cria o .env de verdade na primeira execução, já com os dois
# segredos sorteados. Este arquivo existe para documentar o que dá para mudar.

# --- segredos (o iniciar.sh sorteia; não precisa preencher à mão) ---
# Assina o cookie de sessão do painel. Trocá-lo desloga todo mundo.
JWT_SECRET=
# Exigido no header X-Ingest-Token do POST /eventos. É o mesmo valor que vai no
# hook do container do Valheim.
INGEST_TOKEN=

# --- conta administrativa inicial ---
ADMIN_EMAIL=admin@valheim.local
# Vazia = o boot sorteia uma senha e a imprime UMA VEZ no log:
#   docker compose logs app | grep -A3 "CONTA ADMINISTRATIVA"
ADMIN_SENHA=

# --- Discord (opcional: o painel configura tudo isto depois) ---
# Caminho simples: um webhook de canal.
DISCORD_WEBHOOK_URL=
# Caminho do app/bot: token + ID do canal. Se os dois estiverem preenchidos,
# este caminho vence o webhook.
DISCORD_BOT_TOKEN=
DISCORD_CHANNEL_ID=

# --- identificação ---
SERVIDOR=playground
# Aspas quando o valor tem espaço: o Compose as remove, e elas evitam que
# qualquer script que leia este arquivo tropece no espaço.
PAINEL_TITULO="Valheim — playground"

# --- domínio público (deixe tudo em branco para uso local/LAN) ---
#
# BASE_DOMAIN é o domínio guarda-chuva: qualquer origem sob ".atila.cloud" é
# aceita pelo CORS, então um subdomínio novo não exige mexer na configuração.
BASE_DOMAIN=atila.cloud
# Endereço público do painel. Entra sozinho na lista de origens aceitas e é o
# endereço que o serviço imprime no log do boot.
PAINEL_DOMINIO=valheim.atila.cloud
# Ligue ao publicar em HTTPS: o cookie de sessão passa a só trafegar cifrado.
# Mantenha "false" enquanto o acesso for http://ip-da-lan:6060, senão o
# navegador descarta o cookie e o login parece não funcionar.
COOKIE_SEGURO=true
# Domínio do cookie. Vazio = vale só para valheim.atila.cloud (o mais restrito).
# Use ".atila.cloud" apenas se a sessão precisar valer em outros subdomínios.
COOKIE_DOMINIO=
# Faixa do proxy reverso (nginx, Caddy, Traefik), separada por vírgula. Sem
# isto, o IP de todo request no log é o do proxy.
# Numa rede padrão do Docker: 172.16.0.0/12
TRUSTED_PROXY=172.16.0.0/12
# Origens extras aceitas pelo CORS, separadas por vírgula. Normalmente vazio:
# BASE_DOMAIN e PAINEL_DOMINIO já cobrem o caso comum.
CORS_ORIGENS=
# E-mail do Let's Encrypt (avisos de expiração), usado pelo perfil `proxy`.
ACME_EMAIL=

# --- rede e banco ---
HTTP_PORT=6060
# Em quem a porta é publicada. Num servidor com IP público use 172.17.0.1 (a
# ponte do Docker): o container do Valheim chega por host.docker.internal, o
# proxy reverso chega pelo host, e a internet não chega.
# Numa máquina caseira, 0.0.0.0 (o padrão) está bom.
BIND_ADDR=0.0.0.0
PG_USER=valheim
PG_PWD=valheim
PG_DB=valheim

# Fuso da máquina que roda o servidor de Valheim: o carimbo das linhas de log
# vem sem fuso, e é este TZ que diz como lê-lo.
TZ=America/Sao_Paulo
